{
  "expo": {
    "name": "Party Playlist",
    "slug": "party-play-list",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.freiolabs.partyplaylist"
    },
    "android": {
      "package": "com.freiolabs.partyplaylist"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#44ace8"
        }
      ]
    ]
  }
}
